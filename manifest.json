{
  "manifest_version": 3,
  "name": "아캠 플러스",
  "version": "1.8.65",
  "description": "즐겨찾기 과목의 과제와 강의콘텐츠 마감을 확인하고, 아이캠퍼스를 읽기 좋은 다크 모드로 보여 줍니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage", "notifications", "alarms", "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": ["management", "contentSettings", "nativeMessaging", "downloads", "cookies", "identity"],
  "optional_host_permissions": ["https://vod.skku.edu/*", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "vod_referer", "enabled": true, "path": "dnr/vod-referer.json" }]
  },
  "host_permissions": [
    "https://canvas.skku.edu/*", "https://icampus.skku.edu/xn-sso/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lcms.skku.edu/*"
      ],
      "css": ["player-layout.css"],
      "js": [
        "errlog.js",
        "video-save-ui.js",
        "player.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://canvas.skku.edu/*"
      ],
      "exclude_matches": [
        "https://canvas.skku.edu/xn-sso/*"
      ],
      "css": [
        "dark/sheets.css",
        "dark/instui.css",
        "dark/dark.css",
        "dark/adapt.css",
        "responsive.css"
      ],
      "js": [
        "dark/color.js",
        "dark/boot.js",
        "dark/transform.js",
        "dark/styles.js",
        "dark/adapt.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://canvas.skku.edu/xn-sso/*",
        "https://icampus.skku.edu/xn-sso/*"
      ],
      "css": [
        "dark/dark.css"
      ],
      "js": [
        "dark/boot.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://canvas.skku.edu/*"
      ],
      "exclude_matches": [
        "https://canvas.skku.edu/xn-sso/*"
      ],
      "js": ["theater.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://canvas.skku.edu/*"
      ],
      "exclude_matches": [
        "https://canvas.skku.edu/xn-sso/*"
      ],
      "js": [
        "timetable.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://canvas.skku.edu/conversations*"
      ],
      "css": ["inbox-split.css"],
      "js": [
        "inbox-badge.js",
        "inbox-split.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://canvas.skku.edu/*"
      ],
      "exclude_matches": [
        "https://canvas.skku.edu/xn-sso/*"
      ],
      "js": [
        "dark/exam-guard.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://canvas.skku.edu/*"
      ],
      "exclude_matches": [
        "https://canvas.skku.edu/xn-sso/*"
      ],
      "css": [
        "dashboard.css"
      ],
      "js": [
        "dashboard.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://kingoinfo.skku.edu/gaia/nxui/index.html*"
      ],
      "js": [
        "timetable-portal.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "아캠 플러스 열기"
    }
  },
  "action": {
    "default_title": "아캠 플러스",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
